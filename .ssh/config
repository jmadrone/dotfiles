# Available IdentityAgent sockets:
# - 1Password SSH Agent - ~/.1password/agent.sock
# - yubikey-agent - /opt/homebrew/var/run/yubikey-agent.sock
# - gpg-agent - /Users/josh/.gnupg/S.gpg-agent.ssh
# - System ssh-agent - /var/folders/62/{random_string}/agent.1740
#     _Note:_ The above line shows the path to the socket file for the OpenSSH agent,
#     which changes every time the agent is started, so don't use this path.
# Available PKCS#11 Providers:
# - PKCS11Provider - /usr/local/lib/libykcs11.dylib # Yubico's PKCS#11 Library for Yubikeys
# - PKCS11Provider - /opt/homebrew/lib/libykcs11.dylib # Yubico's PKCS#11 Library for Yubikeys (Apple Silicon)
# - PKCS11Provider - /usr/local/lib/opensc-pkcs11.so # OpenSC PKCS#11 Library
# - PKCS11Provider - /usr/lib/ssh-keychain.dylib # macOS SSH Keychain Library

# Include 1Password [SSH Agent Bookmarks](https://developer.1password.com/docs/ssh/bookmarks/)
Include ~/.ssh/1Password/config

## GLOBAL DEFAULTS
Host *
    
    IgnoreUnknown UseKeychain
    PubkeyAuthentication yes
    ServerAliveInterval 60
    ServerAliveCountMax 2

    # Host key verification -- set explicitly so a system ssh_config cannot
    # weaken it (user config is parsed first; first value obtained wins).
    # /opt/homebrew/etc/ssh/ssh_config was silently setting
    # "StrictHostKeyChecking no" + "UserKnownHostsFile=/dev/null".
    StrictHostKeyChecking ask
    UserKnownHostsFile ~/.ssh/known_hosts

    # Primary: Use 1Password agent socket
    #IdentityAgent ~/.1password/agent.sock
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

    # Backup: Use Yubikey PIV hardware keys PKCS#11 providers
    # PKCS11Provider /usr/local/lib/opensc-pkcs11.so
    PKCS11Provider /opt/homebrew/lib/libykcs11.dylib
    # PKCS11Provider /usr/local/lib/libykcs11.dylib
    # PKCS11Provider /usr/lib/ssh-keychain.dylib

    # Backup: Use yubikey-agent socket
    IdentityAgent /opt/homebrew/var/run/yubikey-agent.sock
    #PKCS11Provider none
    #IdentityAgent ~/.config/yubikey-agent/ssh-agent.sock

    IdentitiesOnly yes
    #AddKeysToAgent no
    PreferredAuthentications publickey,keyboard-interactive,password
    IPQoS cs7

    # Reuse one TCP connection per host (huge speedup on repeat/parallel sessions).
    # Socket dir must exist: mkdir -p ~/.ssh/cm && chmod 700 ~/.ssh/cm
    ControlMaster auto
    ControlPath ~/.ssh/cm/%C
    ControlPersist 10m


